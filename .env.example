# Telegram bot token used to verify the Login Widget hash (the bot whose
# username appears in the login button). Staff log in via this bot.
BOT_TOKEN=

# Bot username (without @) — used by the JS Telegram Login Widget
BOT_USERNAME=

# Random 32+ char hex string for JWT signing (python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Path to the ERP's own SQLite database (persisted in the Coolify volume)
DB_PATH=/app/data/garment_erp.db

# Directory for uploaded sample images / blueprint files (inside the volume)
UPLOAD_DIR=/app/data/uploads

# Comma-separated Telegram user IDs allowed to bootstrap-login as admin
# (the very first login creates an admin app_user; afterwards manage roles in-app)
ALLOWED_USERS=

# Optional: Telegram bot + chat for in-app business notifications
# (low stock, overdue invoices). Can reuse the shared notification bot.
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# Logging level
LOG_LEVEL=INFO

# Default timezone for date display
TIMEZONE=Africa/Cairo
